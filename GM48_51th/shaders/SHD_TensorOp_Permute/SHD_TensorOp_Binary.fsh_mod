#region MAIN FUNCTION.


void main()
{
  vec2 dstPosition = floor(gl_FragCoord.xy);
  float dstIndex = Permute(FSH_Dst_Meta, dstPosition);
  
  float lhsSample = Get(
    FSH_Lhs_Sampler, 
    FSH_Lhs_Meta, 
    dstIndex
  );
  
  float rhsSample = Get(
    FSH_Rhs_Sampler, 
    FSH_Rhs_Meta, 
    dstIndex
  );
  
  float result = Operation(lhsSample, rhsSample);
  
  gl_FragData[0] = vec4(result);
}


