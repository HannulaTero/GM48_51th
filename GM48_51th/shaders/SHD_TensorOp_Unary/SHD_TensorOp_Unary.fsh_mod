#region MAIN FUNCTION.


void main()
{
  vec2 dstPosition = floor(gl_FragCoord.xy);
  float dstIndex = Permute(FSH_Dst_Meta, dstPosition);
  
  float sample = Get(
    gm_BaseTexture, 
    FSH_Src_Meta, 
    dstIndex
  );
  
  float result = Operation(sample);
  
  gl_FragData[0] = vec4(result);
}


