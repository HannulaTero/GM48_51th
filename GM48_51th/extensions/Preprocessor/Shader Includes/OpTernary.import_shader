//=============================================================
#pragma import(Header)
//=============================================================

// The uniforms.
uniform sampler2D FSH_Lhs_Sampler;
uniform sampler2D FSH_Mhs_Sampler;
uniform sampler2D FSH_Rhs_Sampler;

uniform vec4 FSH_Dst_Meta;
uniform vec4 FSH_Lhs_Meta;
uniform vec4 FSH_Mhs_Meta;
uniform vec4 FSH_Rhs_Meta;


//=============================================================
//
// OPERATION - DEFINE FUNCTION WHERE INLINED.

float Operation(float lhs, float mhs, float rhs);

//=============================================================

void main()
{
  vec2 dstPosition = floor(gl_FragCoord.xy);
  float dstIndex = Permute(FSH_Dst_Meta, dstPosition);
  
  float lhsSample = Get(
    FSH_Lhs_Sampler, 
    FSH_Lhs_Meta, 
    dstIndex
  );
  
  float mhsSample = Get(
    FSH_Mhs_Sampler, 
    FSH_Mhs_Meta, 
    dstIndex
  );
  
  float rhsSample = Get(
    FSH_Rhs_Sampler, 
    FSH_Rhs_Meta, 
    dstIndex
  );
  
  float result = Operation(lhsSample, mhsSample, rhsSample);
  
  gl_FragData[0] = vec4(result);
}


